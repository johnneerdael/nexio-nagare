#===============
# Sample environment for nexio-nagare. Copy to .env and adjust.
#===============
PORT=7002
BASE_URL=http://127.0.0.1:7002

# Optional: skip the AniList identity-map refresh on container boot.
# Useful in tests or when you have an external refresh cadence.
# SKIP_IDENTITY_REFRESH=1

# Optional: structured per-stream-request match-debug logging to stderr.
# DEBUG_MATCH=1
