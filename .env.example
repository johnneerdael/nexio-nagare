#===============
# Sample environment for nexio-nagare. Copy to .env (next to your
# docker-compose.yml or in your project root) and adjust.
#===============

# Port the addon listens on inside the container — also bound on the host.
PORT=7002

# Public-facing base URL the addon emits in its Stremio manifest (logo path,
# install URLs from the configure page, internal redirects). Set this to the
# URL Stremio clients actually reach the addon at.
#   For local-host installs:    http://127.0.0.1:7002
#   For a reverse-proxied site: https://nagare.example.com
BASE_URL=http://127.0.0.1:7002

# Optional: skip the AniList identity-map refresh on container boot.
# Useful in tests or when you have an external refresh cadence.
# SKIP_IDENTITY_REFRESH=1

# Optional: structured per-stream-request match-debug logging to stderr.
# DEBUG_MATCH=1
